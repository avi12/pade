{
  "name": "pade",
  "description": "PADE (Power ADE) - an Agentic Development Environment that wraps your agent CLI in a comprehension-first GUI",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "node scripts/app-dev.mjs",
    "app:build": "tauri build --no-bundle",
    "release": "node scripts/release.mjs",
    "pacing:fixtures": "node scripts/pacing-fixtures.mjs",
    "check": "avi12-svelte-check --tsconfig ./tsconfig.json",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "lint:size": "node scripts/check-file-size.mjs",
    "lint": "avi12-lint",
    "test:js": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "node scripts/smoke.mjs",
    "test": "bun run test:js && bun run test:rust",
    "fallow": "fallow audit --base HEAD",
    "lint:fix": "avi12-lint --fix",
    "lint:all": "bun run lint && bun run lint:rust && bun run lint:size && bun run fallow"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@xterm/addon-search": "0.17.0-beta.288",
    "@xterm/xterm": "6.1.0-beta.288",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.24.0",
    "fallow": "2.103.0",
    "globals": "^17.13.0",
    "lint-config": "github:avi12/lint-config#v0.12.0",
    "oxfmt": "^0.78.0",
    "oxlint": "1.90.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-ccb": "^3.32.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.10.1",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "bun@1.4.5",
  "trustedDependencies": [
    "esbuild",
    "fallow",
    "@ast-grep/cli"
  ],
  "overrides": {
    "fast-uri": "3.1.4"
  },
  "patchedDependencies": {
    "@xterm/xterm@6.1.0-beta.288": "patches/@xterm__xterm@6.1.0-beta.288.patch",
    "svelte@5.57.2": "patches/svelte@5.57.2.patch"
  }
}
