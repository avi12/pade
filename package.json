{
  "name": "pade",
  "description": "PADE (Power ADE) - an Agentic Development Environment that wraps your agent CLI in a comprehension-first GUI",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "node scripts/app-dev.mjs",
    "app:build": "tauri build --no-bundle",
    "release": "node scripts/release.mjs",
    "pacing:fixtures": "node scripts/pacing-fixtures.mjs",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "lint:size": "node scripts/check-file-size.mjs",
    "lint": "avi12-lint",
    "test:js": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "node scripts/smoke.mjs",
    "test": "pnpm test:js && pnpm test:rust",
    "fallow": "fallow audit --base HEAD",
    "lint:fix": "avi12-lint --fix",
    "lint:all": "pnpm lint && pnpm lint:rust && pnpm lint:size && pnpm fallow"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@xterm/addon-search": "0.17.0-beta.288",
    "@xterm/xterm": "6.1.0-beta.288",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "avi12-lint": "github:avi12/lint-config#v0.4.7&path:/packages/avi12-lint",
    "eslint": "^10.13.0",
    "eslint-config-avi12": "github:avi12/lint-config#v0.4.7&path:/packages/eslint-config",
    "eslint-plugin-svelte": "^3.24.0",
    "fallow": "2.103.0",
    "fallow-config-avi12": "github:avi12/lint-config#v0.4.7&path:/packages/fallow-config",
    "oxfmt": "^0.78.0",
    "oxfmt-config-avi12": "github:avi12/lint-config#v0.4.7&path:/packages/oxfmt-config",
    "oxlint": "1.90.0",
    "oxlint-config-avi12": "github:avi12/lint-config#v0.4.7&path:/packages/oxlint-config",
    "oxlint-plugin-naming": "github:avi12/lint-config#v0.4.7&path:/packages/oxlint-plugin-naming",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-avi12": "github:avi12/lint-config#v0.4.7&path:/packages/stylelint-config",
    "stylelint-config-standard": "^40.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.10.1",
    "tsrs": "0.24.0-ts7.1.0-beta",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
