{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/oxlint-config-avi12/browser.json", "./node_modules/oxlint-plugin-naming/preset.json"],
  "overrides": [
    {
      "files": ["scripts/**", "*.config.ts", "*.config.js"],
      "env": { "node": true }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/release/**",
    "**/.verify/**",
    ".claude/worktrees/**",
    "src-tauri/target/**",
    "src-tauri/gen/**"
  ]
}
